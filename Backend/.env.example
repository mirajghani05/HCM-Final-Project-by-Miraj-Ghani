PORT=5000
MONGO_URI=mongodb://localhost:27017/hcm-lite
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# AI provider: Gemini via Google AI Studio (recommended)
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=30000

# Optional OpenAI-compatible provider (for example OpenRouter).
# Leave GEMINI_API_KEY empty to use these values instead.
# AI_API_KEY=replace_with_your_provider_key
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-3.5-flash
