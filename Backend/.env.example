# Server
PORT=5000
NODE_ENV=development
# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hcm-lite

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Allowed frontend origin(s). Comma-separate multiple origins.
# Example: https://hcm-lite.vercel.app,https://hcm-lite-git-main.vercel.app
CLIENT_URL=http://localhost:5173

# AI provider: Gemini via Google AI Studio (recommended)
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=30000

# Optional: override the AI request referer (defaults to CLIENT_URL)
# FRONTEND_URL=https://your-frontend.vercel.app

# Optional OpenAI-compatible provider (for example OpenRouter).
# Leave GEMINI_API_KEY empty to use these values instead.
# AI_API_KEY=replace_with_your_provider_key
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-3.5-flash
